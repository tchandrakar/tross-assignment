# ─── Server ────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# API key clients must send as `x-api-key`. Comma-separated for multiple keys.
# Leave empty to run the API unauthenticated (not recommended in production).
API_KEYS=

# ─── RECOMMENDED: interactive login ────────────────────────────────────────
# The most reliable way to establish a session. Fill these in, then run:
#
#     npm run login
#
# Signs in over HTTP (no browser), prompts for a verification code if LinkedIn
# asks, and writes the session to SESSION_STATE_DIR. The service does this for
# itself on first use; run it by hand to establish the session from a network
# LinkedIn already trusts. Delete LI_PASSWORD once the session exists.
#
# Why this beats pasting cookies: LinkedIn ROTATES li_at on use and invalidates
# the previous value. A pasted jar is a point-in-time snapshot that goes stale
# within minutes; replaying it looks like a stolen cookie and LinkedIn kills the
# session (`set-cookie: li_at=delete me`). Persisted session state follows the
# rotation instead of fighting it.
IDENTITY_LABEL=primary
LI_EMAIL=
LI_PASSWORD=

# Where the session cookie jar is written. Gitignored — it is a live session,
# so treat it exactly like a credential.
SESSION_STATE_DIR=.sessions

# ─── LinkedIn identities ───────────────────────────────────────────────────
# One or more authenticated LinkedIn sessions. NEVER commit real values.
#
# How to obtain: log in to linkedin.com, open DevTools → Application → Cookies
#   li_at      → the session cookie (long opaque string)
#   JSESSIONID → looks like "ajax:1234567890123456789" (quotes included in the
#                cookie jar; strip them — this value doubles as the CSRF token)
#
# Format: JSON array. `proxy` is optional and pins that identity to a fixed
# egress IP — strongly recommended, see README §Proxy rotation.
#
# LINKEDIN_IDENTITIES='[{"label":"primary","liAt":"AQEDA...","jsessionId":"ajax:1234567890123456789","proxy":"http://user:pass@gw.provider.com:7777"}]'
LINKEDIN_IDENTITIES=

# Convenience single-identity form (used only if LINKEDIN_IDENTITIES is empty).
#
# EASIEST + MOST RELIABLE: paste the entire `cookie:` request header, copied
# from DevTools -> Network -> any linkedin.com request -> Request Headers.
# li_at and JSESSIONID are extracted from it automatically.
#
# This matters beyond convenience: LinkedIn cross-checks li_at against the
# browser-identity cookies that normally accompany it (bcookie, bscookie, lidc,
# li_gc). A bare li_at reads as a replayed stolen cookie and LinkedIn kills the
# session server-side, which shows up as a 302 with `set-cookie: li_at=delete me`.
#
# IMPORTANT: wrap the value in SINGLE quotes. Cookie headers contain double
# quotes (bcookie="v=2&...") and Node's --env-file parser truncates a
# double-quoted value at the first escaped quote, silently yielding a value
# 9 characters long instead of ~1500.
#   LI_COOKIES='bcookie="v=2&..."; li_at=AQED...; JSESSIONID="ajax:123..."; lidc="b=OB1..."'
LI_COOKIES=

# Or set the two values individually (session will be shorter-lived).
LI_AT=
LI_JSESSIONID=

# ─── Proxy pool ────────────────────────────────────────────────────────────
# Comma-separated proxy URLs, assigned round-robin to identities that don't
# declare their own `proxy`. Any HTTP/HTTPS proxy works (Webshare, IPRoyal,
# Decodo, Bright Data, ...).
#   PROXY_URLS=http://user:pass@host:port,http://user:pass@host2:port
PROXY_URLS=

# Template for providers that encode a sticky-session id in the username.
# `{session}` is substituted with a stable per-identity session id so one
# LinkedIn cookie keeps one egress IP. Example (Decodo/Smartproxy):
#   PROXY_STICKY_TEMPLATE=http://USER-session-{session}:PASS@gate.decodo.com:7000
PROXY_STICKY_TEMPLATE=

# ─── Cache (Google Cloud Storage blob store) ───────────────────────────────
# When unset, an in-process LRU is used instead (fine for local dev).
GCS_BUCKET=
GCS_PREFIX=profiles/
# Cached profiles older than this are re-scraped. 0 = never expire.
CACHE_TTL_SECONDS=604800

# ─── Rate limits (three independent tiers) ─────────────────────────────────
# 1. New profiles fetched from LinkedIn per minute, service-wide.
#    Protects the LinkedIn account. Cache hits do NOT consume this.
SCRAPE_RATE_PER_MINUTE=5

# 2. Requests per minute from a single caller (keyed by API key, else client IP).
#    Stops one caller consuming the whole service.
CLIENT_RATE_PER_MINUTE=10

# 3. Total requests per minute across the service, all callers combined.
GLOBAL_RATE_PER_MINUTE=20

# ─── Transport ─────────────────────────────────────────────────────────────
# There is one transport: direct HTTP to LinkedIn's Voyager endpoints. No
# browser is launched anywhere in this service, so there is nothing to enable
# or disable here.
