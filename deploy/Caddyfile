# Automatic HTTPS via Let's Encrypt. Caddy provisions and renews the
# certificate itself, so there is no cert material in the repo or in CI.
{$PUBLIC_HOST} {
	encode gzip

	# Never let a scraper API be indexed or embedded.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy api:8080 {
		# A cold browser launch plus a live scrape can legitimately take a
		# while; the app's own timeouts are the real limit.
		transport http {
			read_timeout 180s
		}
	}
}
