# Common proxy behaviour for every entry point below.
(app) {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# A scraper API has no business being indexed or embedded.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy api:8080 {
		# A cold browser launch plus a live scrape legitimately takes a while;
		# the app's own timeouts are the real limit.
		transport http {
			read_timeout 180s
		}
	}
}

# Canonical endpoint. Caddy provisions and renews the certificate itself, so no
# certificate material lives in the repo or in CI.
{$PUBLIC_HOST} {
	import app
}

# Plain-HTTP fallback on whatever address the request arrived at.
#
# This exists because TLS cannot be issued until the DNS record points here, and
# without it the deployment would be unverifiable in the meantime — you could
# not tell "DNS not pointed yet" apart from "the service is broken". It serves
# the same app; the canonical host above is the one to use.
#
# The `http://` scheme is load-bearing: with a bare `:80`, Caddy's automatic
# HTTPS applies and answers every request with a 308 to https://<ip>, for which
# no certificate can exist. An explicit scheme opts this block out.
http:// {
	import app
}
