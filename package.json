{
  "name": "linkedin-profile-api",
  "version": "1.0.0",
  "description": "Reverse-engineered LinkedIn profile API \u2014 accepts a LinkedIn profile URL, returns structured JSON.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:local": "node --env-file-if-exists=.env dist/index.js",
    "login": "tsx --env-file-if-exists=.env src/browser/login-cli.ts",
    "postman": "newman run postman/LinkedIn-Profile-API.postman_collection.json -e postman/LinkedIn-Profile-API.postman_environment.json --delay-request 7000"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@google-cloud/storage": "^7.14.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "playwright": "^1.49.1",
    "undici": "^7.2.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
